def get_neko(): # the magic happens here !
    global image_url
    global image_src
    global count
    global full_img_url
    if args.verbose:
        print(f"requesting '{url}' with params: {aliases["params"][yand]}")
    res = requests.get(url, params=aliases["params"][yand])
    res.raise_for_status()

    json_data = res.json()

    count = 0
    if yand:
        count = -1
        for i in json_data:
            count += 1
    else:
        if json_data:
            count += 1

    if count <= 0:
        print("no items found in the response; likely no results for your parameters.")
        sys.exit()
    
    if args.verbose:
        print(f"response data: {json_data}")

    picked = randrange(0,count)
    image_url = json_data[picked].get("sample_url") if yand else json_data[0].get("url")
    if yand:
        full_img_url = json_data[picked].get("file_url") if not args.download_sample else image_url
    else:
        full_img_url = json_data[0].get("url") if not args.download_sample else image_url
    image_id = json_data[picked].get("id") if yand else json_data[0].get("id")
    if image_url:
        print(f"❮ Image ID : {image_id} ❯")
        scale_factor = 0.5 if args.terminal and yand else 0.9
        glob_open(image_url, scale_factor * factor_mult)

        if args.print_data:
            print(json_data)
    else:
        print("no image URL found.")

    tags = json_data[picked].get("tags") if yand else json_data[0].get("tags")
    if tags:
        if not yand:
            tags = ", ".join(tags)
        print(f"{symb["tag"][args.disable_nerdfonts]} : {tags}")

    if yand:
        score = json_data[picked].get("score")
        if score:
            print(f"{symb["score"][args.disable_nerdfonts]} : {score}")

    rating = json_data[picked].get("rating") if yand else json_data[0].get("rating")
    if rating and yand:
        yrating_dict = {
            "s" : "safe",
            "q" : "questionable",
            "e" : "explicit"
        }
        rating = yrating_dict[rating]
    if rating:
        print(f"{symb["rating"][args.disable_nerdfonts]} : {rating}")

    image_src = json_data[picked].get("source") if yand else json_data[0].get("source_url")
    if image_src:
        print(f"{symb["source"][args.disable_nerdfonts]} : {image_src}")
    else:
        print("no source link found.")
    print(f"{symb["embed"][args.disable_nerdfonts]} : {image_url}")
    author = json_data[picked].get("author") if yand else json_data[0].get("artist_name")
    if author:
        print(f"{symb["author"][args.disable_nerdfonts]} : {author}")

